    "url": "git+https://github.com/oasysgames/oasys-deterministic-deployment-proxy.git"
  },
  "type": "module",
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.6",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.1",
    "@types/node": "^22.19.2",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.0.17",
    "prettier": "^3.7.4",
    "prettier-plugin-solidity": "^2.2.0",
    "solhint": "^6.0.1",
    "typescript": "~5.8.0",
    "viem": "^2.41.2"
  }
}
