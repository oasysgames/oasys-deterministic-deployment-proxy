{
  "name": "oasys-deterministic-deployment-proxy",
  "version": "1.0.0",
  "description": "Oasys version of the Deterministic Deployment Proxy, embedding whitelist functionality.",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "fmt": "npx prettier --write 'contracts/**/*.sol' 'test/**/*.ts' 'scripts/**/*.ts'",
    "lint": "npx solhint --fix 'contracts/**/*.sol'"
  },
  "repository": {
